[Unit]
Description=GreenLiT deamon to handle the actions if any when system bootup
After=network.target

[Service]
# The resumed suite may wait for systemd boot completion. Type=oneshot would
# keep the boot job active until the suite exits and deadlock that wait.
Type=simple
ExecStart=/usr/bin/glt-test-suite --resume -1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
